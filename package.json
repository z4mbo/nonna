{
  "name": "nonna",
  "productName": "Nonna",
  "version": "0.2.0",
  "description": "An Italian nonna who storms onto your desktop, throws her slipper (ciabatta) at you, and tidies everything into folders.",
  "main": "src/main/main.js",
  "author": "Alessandro Zambon",
  "license": "MIT",
  "homepage": "https://nonna.imbored.fun",
  "repository": "github:z4mbo/nonna",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "assets": "node scripts/gen-assets.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fun.imbored.nonna",
    "productName": "Nonna",
    "files": [
      "src/**/*",
      "assets/nonna/**/*",
      "assets/slipper.png",
      "assets/sounds/*.mp3",
      "assets/icon.png",
      "assets/tray.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Nonna asks Finder where your desktop icons are and hides open windows so she can sweep the desktop."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
